// Use case diagram 1: change request lifecycle (matches SRS section 8).
// Render with: dot -Tpng use-case-lifecycle.dot -o use-case-lifecycle.png
digraph UseCasesLifecycle {
    rankdir=LR;
    graph [fontname="Helvetica", fontsize=12, nodesep=0.3, ranksep=1.3, pad=0.3];
    node  [fontname="Helvetica", fontsize=11];
    edge  [arrowhead=none, color="#555555"];

    Requester [shape=box, style="rounded,filled", fillcolor="#dfe9f5", label="«actor»\nRequester"];
    Reviewer  [shape=box, style="rounded,filled", fillcolor="#dfe9f5", label="«actor»\nReviewer"];
    Engineer  [shape=box, style="rounded,filled", fillcolor="#dfe9f5", label="«actor»\nEngineer"];

    subgraph cluster_cms {
        label="Change Management Software - change request lifecycle";
        style="rounded"; color="#1f4e79"; fontcolor="#1f4e79"; fontsize=13;
        node [shape=ellipse, style=filled, fillcolor="#fffbe6"];

        Create   [label="Create change request"];
        Edit     [label="Edit change request"];
        Close    [label="Close or reopen\nchange request"];
        Comment  [label="Comment on\nchange request"];
        View     [label="Search and view\nchange requests"];
        Review   [label="Review: approve\nor reject"];
        Assign   [label="Assign or reassign\nengineer"];
        StartW   [label="Start work"];
        Resolve  [label="Resolve with summary"];
        History  [label="Record status history", fillcolor="#eeeeee"];
    }

    Requester -> {Create Edit Close Comment View};
    Reviewer  -> {Review Assign Close Edit Comment View};
    {StartW Resolve Comment View} -> Engineer;

    edge [style=dashed, arrowhead=vee, color="#888888", fontsize=9, fontcolor="#666666", label="«include»"];
    Review  -> History;
    Assign  -> History;
    Close   -> History;
    StartW  -> History;
    Resolve -> History;
}
